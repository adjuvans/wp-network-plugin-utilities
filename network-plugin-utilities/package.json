{
  "name": "network-plugin-utilities",
  "version": "1.7.0",
  "description": "Network Plugin Utilities - Must-Use Plugin pour WordPress Multisite",
  "scripts": {
    "watch:css": "sass --watch assets/scss/npu-admin.scss:assets/css/npu-admin.css --style expanded",
    "watch:css:min": "sass --watch assets/scss/npu-admin.scss:assets/css/npu-admin.min.css --style compressed",
    "build:css": "sass assets/scss/npu-admin.scss:assets/css/npu-admin.css --style expanded && sass assets/scss/npu-admin.scss:assets/css/npu-admin.min.css --style compressed",
    "build": "npm run build:css",
    "dev": "npm run watch:css"
  },
  "keywords": [
    "wordpress",
    "multisite",
    "network",
    "utilities",
    "admin"
  ],
  "author": "Cyrille de Gourcy <cyrille@gourcy.net>",
  "license": "GPL-3.0",
  "devDependencies": {
    "sass": "^1.69.0"
  }
}
